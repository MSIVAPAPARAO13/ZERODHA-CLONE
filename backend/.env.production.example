# TradeFlow Production Environment Template
NODE_ENV=production
PORT=3002

# Database Connection (MongoDB Atlas)
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/tradeflow?retryWrites=true&w=majority&appName=TradeFlowCluster

# Authentication & Security
JWT_SECRET=<generate_cryptographically_secure_256bit_secret>
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://tradeflow.vercel.app

# Market Data Providers
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=<your_production_twelve_data_api_key>
ALPHA_VANTAGE_API_KEY=<your_fallback_alpha_vantage_api_key>

# Grounded AI Intelligence
GEMINI_API_KEY=<your_production_gemini_api_key>

# Observability & Logging
LOG_LEVEL=info
